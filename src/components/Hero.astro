---
import projects from '../data/projects.json'

const projectCount = String(projects.length).padStart(2, '0')
const roles = ['Desarrollador full stack', 'Interfaces web responsive', 'Backend y APIs', 'Despliegue continuo']
const chips = [
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#stack', label: 'Frontend' },
  { href: '#stack', label: 'Backend' },
  { href: '#contacto', label: 'Contacto' },
]
---

<section id="inicio" class="hero section-shell">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>Disponible para nuevas oportunidades</p>
    <p class="hero-greeting">Hola, soy</p>
    <h1 class="hero-name">Deg</h1>
    <p class="hero-role" aria-live="off">
      <span id="typed-role" data-roles={JSON.stringify(roles)}>{roles[0]}</span><span class="typed-caret" aria-hidden="true"></span>
    </p>
    <p class="hero-intro">Diseño, desarrollo y despliego aplicaciones web de principio a fin: interfaces responsive, lógica de servidor y publicación en producción, con código mantenible y flujo de trabajo en Git.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#proyectos">Ver proyectos <span aria-hidden="true">→</span></a>
      <a class="button button-ghost" href="#contacto">Contáctame</a>
    </div>
    <div class="role-bank" role="group" aria-label="Accesos rápidos">
      {chips.map((chip) => (
        <a class="role-chip" href={chip.href}><span class="bracket" aria-hidden="true">[</span>{chip.label}<span class="bracket" aria-hidden="true">]</span></a>
      ))}
    </div>
    <div class="hero-meta">
      <span><strong>2+</strong> años de experiencia<br />en desarrollo web</span>
      <span><strong>{projectCount}</strong> {projects.length === 1 ? 'proyecto publicado' : 'proyectos publicados'}<br />en GitHub</span>
    </div>
  </div>

  <div class="hero-console">
    <div class="console-top"><span>terminal — main</span><span class="console-dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
    <div class="avatar-stage">
      <svg class="dev-scene" viewBox="0 0 220 158" role="img" aria-label="Ilustración de un desarrollador escribiendo código y subiendo un proyecto a producción" shape-rendering="crispEdges">
        <!-- nube de despliegue -->
        <g class="scene-cloud">
          <rect x="164" y="10" width="40" height="14" fill="#fff" />
          <rect x="172" y="4" width="14" height="8" fill="#fff" />
          <rect x="186" y="6" width="12" height="6" fill="#fff" />
          <rect x="164" y="24" width="40" height="3" fill="#dff0fb" />
          <rect x="183" y="6" width="4" height="3" fill="#182235" />
          <rect x="181" y="9" width="8" height="3" fill="#182235" />
          <rect x="179" y="12" width="12" height="3" fill="#182235" />
          <rect x="177" y="15" width="16" height="3" fill="#182235" />
          <rect x="182" y="18" width="6" height="5" fill="#182235" />
        </g>
        <!-- paquete que sube a la nube -->
        <g class="scene-package">
          <rect x="181" y="52" width="9" height="9" fill="#f2c14e" stroke="#182235" stroke-width="2" />
          <rect x="184" y="52" width="3" height="9" fill="#ec1c24" />
        </g>

        <!-- escritorio y suelo -->
        <rect x="0" y="146" width="220" height="12" fill="#a83c35" />
        <rect x="0" y="146" width="220" height="3" fill="#182235" />
        <rect x="206" y="117" width="5" height="29" fill="#7d2a27" />
        <rect x="98" y="112" width="122" height="5" fill="#a83c35" stroke="#182235" stroke-width="2" />

        <!-- monitor con terminal -->
        <rect x="159" y="98" width="8" height="14" fill="#182235" />
        <rect x="148" y="110" width="30" height="3" fill="#182235" />
        <rect x="124" y="44" width="82" height="54" fill="#182235" />
