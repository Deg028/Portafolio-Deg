<script>
  // Efecto de escritura para el rol. El HTML ya trae el primer rol, así que sin JS (o con
  // movimiento reducido) el texto se queda fijo y legible.
  const target = document.getElementById('typed-role')
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (target && !reduced) {
    const roles: string[] = JSON.parse(target.dataset.roles ?? '[]')
    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

    async function run() {
      let index = 0
      while (document.body.contains(target)) {
        const role = roles[index % roles.length]
        for (let i = 1; i <= role.length; i++) {
          target!.textContent = role.slice(0, i)
          await sleep(70)
        }
        await sleep(1800)
        for (let i = role.length - 1; i >= 0; i--) {
          target!.textContent = role.slice(0, i)
          await sleep(35)
        }
        await sleep(300)
        index++
      }
    }

    // Se espera un momento para que la primera frase se lea completa antes de borrarla.
    setTimeout(run, 2200)
  }
</script>
