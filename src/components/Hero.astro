        <rect x="79" y="58" width="3" height="3" fill="#1d181e" />
        <rect x="79" y="66" width="8" height="2" fill="#1d181e" />
        <rect x="80" y="69" width="5" height="2" fill="#7a3f3a" />
        <rect x="76" y="70" width="10" height="5" fill="#1d181e" />
        <rect x="68" y="62" width="4" height="6" fill="#9c5a42" />
        <rect x="70" y="84" width="9" height="16" fill="#c4141c" stroke="#182235" stroke-width="2" />
        <g class="scene-hands">
          <rect x="76" y="96" width="30" height="7" fill="#c27a5c" stroke="#182235" stroke-width="2" />
          <rect x="104" y="98" width="10" height="7" fill="#c27a5c" stroke="#182235" stroke-width="2" />
        </g>
        <rect x="104" y="108" width="36" height="4" fill="#f2c14e" stroke="#182235" stroke-width="2" />
      </svg>
      <div class="level-badge"><span class="status-dot" aria-hidden="true"></span>EN LÍNEA</div>
    </div>
    <div class="console-info"><span>ROL</span><strong>DESARROLLADOR<br />FULL STACK</strong></div>
    <div class="console-stack"><span>STACK</span><span>JavaScript · TypeScript · Java · Python</span></div>
    <div class="console-bottom"><span>ESTADO: DISPONIBLE</span><span>///</span></div>
  </div>
</section>

<script>
  // Efecto de escritura para el rol. El HTML ya trae el primer rol, así que sin JS (o con
  // movimiento reducido) el texto se queda fijo y legible.
  const target = document.getElementById('typed-role')
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (target && !reduced) {
    const roles: string[] = JSON.parse(target.dataset.roles ?? '[]')
    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

    async function run() {
      let index = 0
      while (document.body.contains(target)) {
        const role = roles[index % roles.length]
        for (let i = 1; i <= role.length; i++) {
          target!.textContent = role.slice(0, i)
          await sleep(70)
        }
        await sleep(1800)
        for (let i = role.length - 1; i >= 0; i--) {
          target!.textContent = role.slice(0, i)
          await sleep(35)
        }
        await sleep(300)
        index++
      }
    }

    // Se espera un momento para que la primera frase se lea completa antes de borrarla.
    setTimeout(run, 2200)
  }
</script>
