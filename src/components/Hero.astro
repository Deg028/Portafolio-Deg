        <rect x="58" y="104" width="42" height="10" fill="#2a3550" stroke="#182235" stroke-width="2" />
        <rect x="58" y="76" width="22" height="32" fill="#c4141c" stroke="#182235" stroke-width="2" />
        <rect x="66" y="70" width="10" height="8" fill="#9c5a42" />
        <rect x="62" y="46" width="24" height="26" fill="#c27a5c" stroke="#182235" stroke-width="2" />
        <rect x="60" y="40" width="28" height="11" fill="#1d181e" />
        <rect x="62" y="36" width="8" height="5" fill="#1d181e" />
        <rect x="72" y="35" width="8" height="6" fill="#1d181e" />
        <rect x="82" y="37" width="7" height="5" fill="#1d181e" />
        <rect x="58" y="44" width="8" height="22" fill="#1d181e" />
        <rect x="64" y="52" width="4" height="8" fill="#1d181e" />
