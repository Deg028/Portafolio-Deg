---
---

<header class="site-header">
  <div class="header-left">
    <a class="brand" href="#inicio" aria-label="Ir al inicio">
      <span class="brand-mark" aria-hidden="true" id="brand-mark">&lt;/&gt;</span>
      <span class="brand-name">Deg<span class="cursor">_</span></span>
    </a>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false" aria-label="Cambiar tema">
      <span class="theme-icon theme-icon-dark" aria-hidden="true">☾</span>
      <span class="theme-icon theme-icon-light" aria-hidden="true">☀</span>
      <span class="theme-label theme-label-dark">Modo oscuro</span>
      <span class="theme-label theme-label-light">Modo claro</span>
    </button>
  </div>
  <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">MENU</button>
  <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
    <a href="#proyectos">Proyectos</a>
    <a href="#stack">Stack</a>
    <a href="#sobre-mi">Sobre mí</a>
    <a class="github-button" href="https://github.com/Deg028" target="_blank" rel="noreferrer" aria-label="Visitar GitHub de Deg" title="GitHub de Deg">
      <svg class="github-logo" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.5v-1.8c-2.93.64-3.55-1.25-3.55-1.25-.48-1.22-1.17-1.55-1.17-1.55-.96-.66.07-.65.07-.65 1.06.08 1.62 1.09 1.62 1.09.94 1.61 2.46 1.14 3.06.87.1-.68.37-1.14.67-1.4-2.34-.27-4.8-1.17-4.8-5.2 0-1.15.41-2.09 1.08-2.83-.11-.27-.47-1.34.1-2.79 0 0 .88-.28 2.89 1.08A10 10 0 0 1 12 6.7a10 10 0 0 1 2.63.36c2-.136 2.88-1.08 2.88-1.08.57 1.45.21 2.52.1 2.79.68.74 1.09 1.68 1.09 2.83 0 4.04-2.47 4.92-4.82 5.19.38.33.72.97.72 1.96v2.9c0 .27.19.6.73.5A10.5 10.5 0 0 0 12 1.5Z" />
      </svg>
      <span>GitHub</span>
    </a>
  </nav>
</header>

<script>
  const root = document.documentElement
  const storageKey = 'deg-portfolio-theme'
  const colors = { light: '#f6e5e3', dark: '#151b26' }

  function applyTheme(theme: string) {
    root.dataset.theme = theme
    const button = document.getElementById('theme-toggle')
    button?.setAttribute('aria-pressed', String(theme === 'dark'))
    button?.setAttribute('aria-label', theme === 'dark' ? 'Activar modo claro' : 'Activar modo oscuro')
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', colors[theme as 'light' | 'dark'])
  }

  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light')

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
    // La transición suave solo se activa al cambiar de tema, no en la carga inicial.
    root.classList.add('theme-ready')
    applyTheme(next)
    try {
      localStorage.setItem(storageKey, next)
    } catch (error) {
      console.error('No se pudo guardar la preferencia de tema.', error)
    }
  })

  const menuToggle = document.getElementById('menu-toggle')
  const nav = document.getElementById('site-nav')

  function setMenu(open: boolean) {
    nav?.classList.toggle('is-open', open)
    menuToggle?.setAttribute('aria-expanded', String(open))
  }

  menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'))
  nav?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenu(false)
  })
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false)
      menuToggle.focus()
    }
  })

  // El símbolo de la marca cambia cada minuto.
  const symbols = ['</>', '{ }', '[ ]', '=>', '01', '!=', '&&']
  const brandMark = document.getElementById('brand-mark')
  if (brandMark) {
    window.setInterval(() => {
      const options = symbols.filter((symbol) => symbol !== brandMark.textContent)
      brandMark.textContent = options[Math.floor(Math.random() * options.length)]
    }, 60_000)
  }
</script>
